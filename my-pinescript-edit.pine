// ────────── Background Coloring ──────────
bgcolor(color=rsi_value < rsi_oversold   ? color.new(color.green, 90) : na)
bgcolor(color=rsi_value > rsi_overbought ? color.new(color.red,   90) : na)

// ────────── Alerts ──────────
alertcondition(long_condition,  title="Long Alert",  message="Long Trade Entry Condition Met")
alertcondition(short_condition, title="Short Alert", message="Short Trade Entry Condition Met")