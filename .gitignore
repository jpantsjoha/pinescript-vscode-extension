# Vendored third-party MCP projects, cloned for reference only. Not part of this
# extension and not ours to redistribute:
#   mcp/pinescript-mcp-server/ -> github.com/CyberBOB07/pinescript-mcp-server (own .git)
#   mcp/tradingview-mcp/       -> separate Python project
mcp/pinescript-mcp-server/
mcp/tradingview-mcp/

# Scratch Pine files at the repo root. `my-pinescript-edit.pine` (an 811-line
# strategy) sat here tracked; anything ad-hoc belongs outside version control.
/*.pine

# Author's own Pine strategies — proprietary, never public.
# The CI golden corpus lives in test/fixtures/corpus/ (synthetic fixtures) so the
# false-positive gate works without exposing any trading logic. See CLAUDE.md.
examples/

# Working directory — process notes, planning, audits, release runbooks.
# Same convention as _plugin/ in googlecloud-plugin and pinescript-plugin:
# operational detail stays out of the public repo.
_process/
