# Build output
dist/
*.tsbuildinfo
build/

# Packaged extensions — a build artefact, never committed. One was tracked at the
# repo root for a whole release cycle (1.8 MB of stale binary).
*.vsix

# Dependencies
node_modules/

# IDE & Editor
.vscode/
.idea/
# .claude/ is tracked: it carries the project hooks and agent definitions.
# Only the personal, machine-specific overrides stay out of git.
.claude/settings.local.json
*.swp
*.swo
*~

# Agent definitions (private development context)
multi-agent-devex/
.CLAUDE.md
# GEMINI.md - Now public! AI assistant context for Pine Script v6

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scraped documentation (regenerate as needed)
v6/raw/*
!v6/raw/v6-language-constructs.json
v6/docs-crawled/
v6/scripts/

# Temporary files
*.tmp
*.temp
.cache/

# Local development & secrets.
# Credentials belong in ~/.config/vscode-publishing/publish.env or the macOS
# keychain, never in a project directory — a repo-local secret is one `git add -A`
# away from being public, and this repo IS public.
.env
.env.*
!.env.example
*.pat
*.token
secrets.json
.npmrc

# Test coverage
coverage/
.nyc_output/

